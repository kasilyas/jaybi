# --- Jaybi Backend ---

# Environnement: development | test | production
NODE_ENV=development

# Base de données (PostgreSQL). En dev local via docker-compose.
DATABASE_URL="postgresql://jaybi:jaybi@localhost:5432/jaybi?schema=public"

# Auth
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# OTP email. En dev (DEV_BYPASS=true), aucun envoi réel: le code est 123456
# et est retourné/affiché. En prod, brancher un transport SMTP.
DEV_BYPASS=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Jaybi <no-reply@jaybi.ma>"
SMTP_REQUIRE_TLS=true
# URL de Mailpit uniquement pour les tests locaux. Laisser vide en production.
LOCAL_MAILBOX_URL=

# IA — secret serveur uniquement, jamais préfixé par VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
