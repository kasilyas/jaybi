# --- Jaybi Frontend (Vite) ---
# Copier ce fichier en .env.local et ajuster les valeurs.

# Bypass 2FA / auto-login de test en développement.
# NE JAMAIS mettre à true en production.
VITE_DEV_BYPASS=true

# URL du backend API (Express). En local : http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api
